   "source": [
    "def solution(N, stages):\n",
    "    answer = []\n",
    "    fail =[]\n",
    "    \n",
    "    for i in stages:\n",
    "        for j in i:\n",
    "            fail[j]+=1\n",
    "    for i in range(stages):\n",
    "        answer = fail[i] / fail[len(stages - i)]\n",
    "    answer.sort(reverse = true)\n",
    "    return answer"
   ]
  }
