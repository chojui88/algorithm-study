   "source": [
    "\n",
    "SELECT o.PRODUCT_ID, p.PRODUCT_NAME, sum(price) as TOTAL_SALES\n",
    "from FOOD_ORDER o \n",
    "left join FOOD_PRODUCT p\n",
    "where PRODUCE_DATE like \"2022-05%\"\n",
    "order by TOTAL_SALES desc, o.PRODUCT_ID"
   ]
