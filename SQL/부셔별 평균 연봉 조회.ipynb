   "source": [
    "### 질문\n",
    "1. select 에서 as를 쓴 다음에 order by 에서 그 as로 정렬을 해도 되나?\n",
    "-> 된다\n",
    "\n",
    "2. 반올림 sql 문법\n",
    "round(숫자, 자리)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c0d6ec6b",
   "metadata": {
    "vscode": {
     "languageId": "sql"
    }
   },
   "outputs": [],
   "source": [
    "select emp.DEPT_ID, dep.DEPT_NAME_EN, round(avg(emp.sal),0) as AVG_SAL\n",
    "from HR_DEPARTMENT dep\n",
    "join HR_EMPLOYEES emp\n",
    "on dep.DEPT_ID = emp.DEPT_ID\n",
    "group by dep.DEPT_ID\n",
    "order by avg_sal desc"
   ]
  },
