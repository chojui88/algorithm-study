    "#입력 k\n",
    "\n",
    "k = int(input())\n",
    "\n",
    "#길이가 7인 부분 문자열중 akaraka가 k번 나타나는 가장 짧은 문자열\n",
    "#aka/raka/raka/raka\n",
    "#1. 첫번재 시작하는 것은 aka로 시작하고\n",
    "answer = \"AKA\"\n",
    "#2. 여기서 숫자가 하나 증가할 때마다 raka를 붙인다 \n",
    "for i in range(int(k)): #\n",
    "    answer+= \"RAKA\"\n",
    "\n",
    "print(answer)\n",
    "\n"
